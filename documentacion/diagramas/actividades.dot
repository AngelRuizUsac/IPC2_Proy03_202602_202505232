r6 [label="Actualizar nombre\nContar actualizado"];
r7 [label="Contar NIT inválido"];
r8 [label="Guardar copia en archivo\nReemplazar estado en memoria"];
r9 [shape=oval,label="Responder tres contadores"];
r0 -> r1 -> r2; r2 -> r3 [label="Sí"]; r2 -> r8 [label="No"]; r3 -> r4 [label="Sí"]; r3 -> r7 [label="No"];
r4 -> r6 [label="Sí"]; r4 -> r5 [label="No"]; r5 -> r2; r6 -> r2; r7 -> r2; r8 -> r9;
}
subgraph cluster_aut {label="Autorizar documentos";fontname="Arial";
a0 [shape=oval,label="Recibir arreglo JSON"];
