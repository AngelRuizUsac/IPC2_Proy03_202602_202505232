digraph G {
graph [rankdir=TB,nodesep=0.3,ranksep=0.35]; node [shape=box,fontname="Arial",fontsize=11]; edge [fontname="Arial",fontsize=10];
subgraph cluster_rtu {label="Actualizar RTU"; fontname="Arial";
